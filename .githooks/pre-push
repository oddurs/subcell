#!/bin/sh
# The default branch only ever advances through a merged pull request.
set -eu
root=$(git rev-parse --show-toplevel)

# A pipeline's exit status is the *last* command's, so `... | sed || echo main`
# never falls back — sed succeeds on empty input. Resolve step by step instead.
default=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null) || default=""
default=${default#origin/}
if [ -z "$default" ]; then
    default=$(git config --get init.defaultBranch 2>/dev/null) || default=""
fi
[ -n "$default" ] || default=main

while read -r local_ref _ remote_ref _; do
    [ -z "${remote_ref:-}" ] && continue
    case "$remote_ref" in
        "refs/heads/$default")
            printf '\n\033[31mpre-push: refusing to push to %s.\033[0m\n' "$default" >&2
            printf 'Open a pull request instead:  scripts/agent pr\n\n' >&2
            exit 1
            ;;
    esac
    [ -n "${local_ref:-}" ] || continue
done

printf 'pre-push: full check\n'
"$root/scripts/task" check
