#!/bin/sh
# Fast gate: formatting and lint. The full suite runs in pre-push.
set -eu
root=$(git rev-parse --show-toplevel)

# Nothing staged in Rust? Nothing to check.
if ! git diff --cached --name-only --diff-filter=ACMR | grep -q '\.rs$'; then
    exit 0
fi

printf 'pre-commit: fmt:check\n'
if ! "$root/scripts/task" fmt:check; then
    printf '\n\033[31mFormatting drift. Run: scripts/task fmt\033[0m\n\n' >&2
    exit 1
fi

printf 'pre-commit: lint\n'
"$root/scripts/task" lint
