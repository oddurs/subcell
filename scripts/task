#!/bin/sh
# The single seam between this project and everything that automates it.
# CI, the git hooks and scripts/agent all go through here, so they cannot drift
# from each other or from what a developer runs by hand.
set -eu

usage() {
    cat <<'USAGE'
usage: scripts/task <target>

  fmt        format in place
  fmt:check  verify formatting, non-zero on drift
  lint       clippy, warnings denied
  test       full test suite, including doc tests
  build      compile every crate and binary
  docs       build rustdoc, warnings denied
  check      fmt:check && lint && test && build
USAGE
}

case "${1:-}" in
    fmt)       cargo fmt --all ;;
    fmt:check) cargo fmt --all -- --check ;;
    lint)      cargo clippy --workspace --all-targets --all-features -- -D warnings ;;
    test)      cargo test --workspace --all-features ;;
    build)     cargo build --workspace --all-targets ;;
    docs)      RUSTDOCFLAGS="-D warnings" cargo doc --workspace --no-deps ;;
    check)
        "$0" fmt:check
        "$0" lint
        "$0" test
        "$0" build
        ;;
    ""|-h|--help|help) usage ;;
    *)
        printf 'task: unknown target "%s"\n\n' "$1" >&2
        usage >&2
        exit 2
        ;;
esac
